# --- Account Booster (/booster) ---

# MongoDB
MONGODB_URI=mongodb://localhost:27017/usav

# NextAuth — NEXTAUTH_URL must be the site origin (no /booster suffix)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:5080

# Discord OAuth app (https://discord.com/developers/applications)
# Add this redirect URL in the app's OAuth2 settings:
#   <NEXTAUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord server whose roles become site roles. Enable Developer Mode in Discord,
# then right-click the server → Copy Server ID. Leave empty to keep roles stored in the database.
DISCORD_GUILD_ID=
# Discord role ID → site role (admin | user), comma separated. Right-click a role → Copy Role ID.
# Members with none of these roles become "user".
DISCORD_ROLE_MAP=
# true = only members of DISCORD_GUILD_ID can sign in
DISCORD_REQUIRE_MEMBERSHIP=false
